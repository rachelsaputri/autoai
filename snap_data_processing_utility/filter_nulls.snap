when green flag clicked
clear
set [filtered v] data to []
set [audit log v] data to []
repeat (length of [input v] data)
    set [current v] to (item (count) of [input v] data)
    if <(current) > <>> then
        add (current) to [filtered v] data
        add (join "Validated: " (current)) to [audit log v]
    else
        add (join "Filtered null: " (count)) to [audit log v]
    end
end
set [output v] data to [filtered v] data
report [filtered v] data
