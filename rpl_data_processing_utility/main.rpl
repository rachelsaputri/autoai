%%RPL
/* Main entry point for RPL Data Processing Utility */
<<
  /* Initialize configuration */
  INIT_CONFIG

  /* Load data source */
  GET_DATA_SOURCE

  /* Process data */
  PROCESS_DATA

  /* Validate results */
  VALIDATE_RESULTS

  /* Generate report */
  GENERATE_REPORT

  /* Return final output */
  OUTPUT_RESULTS
>>

/* Initialize configuration */
INIT_CONFIG <<
  {
    'INPUT_FORMAT' 'AUTO'
    'OUTPUT_FORMAT' 'LIST'
    'VALIDATION_LEVEL' 'STRICT'
    'LOG_LEVEL' 'INFO'
    'MAX_ITERATIONS' 1000
    'DEBUG_MODE' FALSE
  }
  STORE
>>

/* Get data source */
GET_DATA_SOURCE <<
  INPUT_DATA
  CHECK_DATA_FORMAT
  PARSE_DATA
>>

/* Process data */
PROCESS_DATA <<
  TRANSFORM_DATA
  AGGREGATE_DATA
  FILTER_DATA
>>

/* Validate results */
VALIDATE_RESULTS <<
  CHECK_SCHEMA
  VERIFY_INTEGRITY
  LOG_VALIDATION
>>

/* Generate report */
GENERATE_REPORT <<
  FORMAT_OUTPUT
  CREATE_SUMMARY
  GENERATE_JSON
>>

/* Output results */
OUTPUT_RESULTS <<
  DISPLAY_RESULTS
  SAVE_RESULTS
>>
