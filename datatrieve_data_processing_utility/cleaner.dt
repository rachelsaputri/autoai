$DATATRIEVE - DATA CLEANING ROUTINES
* THIS MODULE PROCESSES RAW DATA IN WORK_AREA
* AND WRITES CLEANED RECORDS TO CLEAN_DATA.

DEFINE VARIABLE CURRENT_RECORD STRUCTURE FROM WORK_AREA
DEFINE VARIABLE CLEAN_RECORD STRUCTURE FROM CLEAN_DATA

BEGIN
  DISPLAY 'LOADING RAW DATA...'
  LOAD WORK_AREA INTO CURRENT_RECORD

  IF CURRENT_RECORD.STATUS = 'INVALID' THEN
    DELETE CURRENT_RECORD
    WRITE ERROR_LOG 'INVALID RECORD: ' + CURRENT_RECORD.ID
  ELSE
    * NORMALIZE FIELD FORMATS
    CURRENT_RECORD.PHONE = FORMAT_PHONE(CURRENT_RECORD.PHONE)
    CURRENT_RECORD.EMAIL = LOWER(CURRENT_RECORD.EMAIL)
    IF CURRENT_RECORD.ZIP = MISSING THEN
      CURRENT_RECORD.ZIP = '00000'
    END IF

    * WRITES TO CLEAN_DATA AUTOMATICALLY VIA DATATRIEVE OUTPUT MECHANISM
    OUTPUT CLEAN_DATA FROM CURRENT_RECORD
  END IF

  DISPLAY 'CLEANING COMPLETE.'
END
