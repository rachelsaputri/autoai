$DATATRIEVE - DATA TRANSFORMATION LOGIC
* THIS MODULE APPLIES BUSINESS LOGIC TO CLEANED DATA.
* OUTPUT IS WRITTEN TO FINAL_REPORT DATASET.

DEFINE VARIABLE CLEAN_REC STRUCTURE FROM CLEAN_DATA
DEFINE VARIABLE TRANSFORMED_REC STRUCTURE FROM FINAL_REPORT

BEGIN
  DISPLAY 'LOADING CLEANED DATA...'
  LOAD CLEAN_DATA INTO CLEAN_REC

  * APPLY TRANSFORMATIONS
  * EXAMPLE: CURRENCY CONVERSION OR DATE STANDARDIZATION
  TRANSFORMED_REC.CUSTOMER_ID = CLEAN_REC.ID
  TRANSFORMED_REC.FULL_NAME = UPPER(CLEAN_REC.FIRST_NAME) + ' ' + UPPER(CLEAN_REC.LAST_NAME)
  TRANSFORMED_REC.ACTIVE_STATUS = DETERMINE_STATUS(CLEAN_REC.LAST_ACTIVITY)
  TRANSFORMED_REC.CREATED_DATE = CURRENT_DATE

  * WRITE TRANSFORMED RECORD
  OUTPUT FINAL_REPORT FROM TRANSFORMED_REC

  DISPLAY 'TRANSFORMATION COMPLETE.'
END
