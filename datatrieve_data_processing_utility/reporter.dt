$DATATRIEVE - REPORT GENERATION
* THIS MODULE GENERATES THE FINAL REPORT IN DELIMITED FORMAT.
* OUTPUTS FINAL_REPORT DATASET TO A MAINFRAME DATASET.

DEFINE VARIABLE REPORT_DATA STRUCTURE FROM FINAL_REPORT

BEGIN
  DISPLAY 'GENERATING REPORT...'
  LOAD FINAL_REPORT INTO REPORT_DATA

  * CONFIGURE OUTPUT FORMAT
  FORMAT DELIMITED, SEPARATOR=COMMA, HEADER=YES

  * OUTPUT TO TARGET DATASET
  OUTPUT FINAL_REPORT TO 'SYS1.REPORTS.CUSTOMER_CSV'

  * VERIFY SUCCESS
  IF STATUS = 0 THEN
    DISPLAY 'REPORT GENERATED SUCCESSFULLY.'
  ELSE
    DISPLAY 'REPORT GENERATION FAILED. STATUS=' + STATUS
    WRITE ERROR_LOG 'REPORT GENERATION ERROR: ' + STATUS
  END IF

  DISPLAY 'PROCESSING ENDED.'
END
