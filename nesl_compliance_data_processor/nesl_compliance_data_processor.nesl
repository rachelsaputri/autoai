/**
 * NESL Compliance Data Processor
 * 
 * This module defines a high-performance, parallel data processing pipeline
 * for compliance auditing. It handles ingestion, validation, transformation,
 * and aggregation of log data.
 */

// ---------------------------------------------------------------------------
// Data Types and Constants
// ---------------------------------------------------------------------------

define type log_entry = { id: int, timestamp: real, event_type: int, severity: int, details: string };
define type violation = { id: int, rule_id: int, severity: int, count: int };

define const MAX_RECORDS = 1000000;
define const SEVERITY_THRESHOLD = 5;

// ---------------------------------------------------------------------------
// Core Processing Functions
// ---------------------------------------------------------------------------

/**
 * Validates a single log entry.
 * Returns true if the entry is structurally sound and meets basic compliance rules.
 */
fun is_valid_entry(e: log_entry) : bool =
  let
    id_valid = e.id > 0;
    ts_valid = e.timestamp >= 0.0;
    type_valid = (e.event_type >= 0) and (e.event_type <= 100);
    sev_valid = (e.severity >= 0) and (e.severity <= 10);
    details_non_empty = size(e.details) > 0;
  in
    id_valid and ts_valid and type_valid and sev_valid and details_non_empty
  end;

/**
 * Filters a list of log entries, keeping only valid ones.
 * Uses parallel map and reduce for efficiency.
 */
fun filter_valid_entries(entries: list log_entry) : list log_entry =
  let
    // Create a boolean mask for validity
    valid_mask = map (fn e => is_valid_entry(e)) entries;
    
    // Filter entries based on the mask
    filtered = compress(valid_mask, entries);
  in
    filtered
  end;

/**
 * Transforms log entries into a standardized format.
 * Normalizes timestamps and categorizes events.
 */
fun transform_entries(entries: list log_entry) : list log_entry =
  let
    transform_fn = fn e =>
      {
        id = e.id,
        timestamp = e.timestamp - min(map (fn x => x.timestamp) entries), // Normalize relative to start
        event_type = e.event_type,
        severity = e.severity,
        details = to_upper(e.details)
      };
  in
    map transform_fn entries
  end;

/**
 * Aggregates violations based on severity and event type.
 * Groups entries by event type and calculates violation counts.
 */
fun aggregate_violations(entries: list log_entry) : list violation =
  let
    // Filter high-severity events as potential violations
    potential_violations = filter (fn e => e.severity >= SEVERITY_THRESHOLD) entries;
    
    // Group by event type
    group_by_type = group_by (fn e => e.event_type) potential_violations;
    
    // Calculate counts and max severity for each group
    group_stats = map (fn g =>
      {
        rule_id = g.index,
        severity = max(map (fn e => e.severity) g.value),
        count = size(g.value)
      }
    ) group_by_type;
  in
    group_stats
  end;

/**
 * Main processing pipeline.
 * Ingests raw data, validates, transforms, and aggregates.
 */
fun process_compliance_data(raw_data: list log_entry) : list violation =
  let
    // Step 1: Validation
    valid_data = filter_valid_entries(raw_data);
    
    // Step 2: Transformation
    transformed_data = transform_entries(valid_data);
    
    // Step 3: Aggregation
    violations = aggregate_violations(transformed_data);
  in
    violations
  end;

// ---------------------------------------------------------------------------
// Main Entry Point
// ---------------------------------------------------------------------------

fun main() : int =
  let
    // Simulate raw data ingestion
    // In a real scenario, this would read from a file or stream
    raw_data = [
      { id: 1, timestamp: 1672531200.0, event_type: 1, severity: 2, details: "login_attempt" },
      { id: 2, timestamp: 1672531260.0, event_type: 5, severity: 8, details: "unauthorized_access" },
      { id: 3, timestamp: 1672531320.0, event_type: 1, severity: 1, details: "login_success" },
      { id: 4, timestamp: 1672531380.0, event_type: 10, severity: 7, details: "data_exfiltration_attempt" },
      { id: 5, timestamp: 1672531440.0, event_type: 5, severity: 9, details: "privilege_escalation" },
      // Invalid entries to test filtering
      { id: -1, timestamp: 1672531500.0, event_type: 1, severity: 1, details: "invalid_id" },
      { id: 6, timestamp: -10.0, event_type: 1, severity: 1, details: "negative_timestamp" },
      { id: 7, timestamp: 1672531560.0, event_type: 150, severity: 1, details: "invalid_event_type" }
    ];
    
    // Process data
    violations = process_compliance_data(raw_data);
    
    // Output results
    report = 
      "Compliance Processing Complete.\n" ++
      "Total Violations Found: " ++ show(size(violations)) ++ "\n" ++
      "Details:\n" ++
      foldl (fn (v, acc) => acc ++ "  - Rule: " ++ show(v.rule_id) ++ ", Count: " ++ show(v.count) ++ ", Max Severity: " ++ show(v.severity) ++ "\n") "" violations;
    
    println(report);
    0
  end;

// Execute main
main();
