/*
 * Audit Trail
 * 
 * This module manages the logging of enforcement actions
 * for audit and compliance purposes.
 */

module audit_trail

import policy_def
import enforcement_engine

// Structure for an Audit Log Entry
policy AuditEntry {
    timestamp: String,
    policy_id: String,
    rule_id: String,
    action: EnforcementAction,
    state_snapshot: Map[String, Any]
}

// List to store audit logs
let audit_log = List[AuditEntry]()

// Log an enforcement action
fun log_action(entry: AuditEntry) {
    audit_log = audit_log + entry
}

// Record an action for a policy execution
fun record_policy_execution(policy: Policy, state: Map[String, Any]) {
    let actions = enforcement_engine.enforce_policies([policy], state)
    let timestamp = compliance_reporter.get_current_timestamp()
    
    for action in actions {
        let entry = AuditEntry(
            timestamp: timestamp,
            policy_id: policy.id,
            rule_id: "generic_rule",
            action: action,
            state_snapshot: state
        )
        audit_trail.log_action(entry)
    }
}

// Get the current audit log
fun get_audit_log() -> List[AuditEntry] {
    return audit_log
}

end module
