import 'data_types.miis'

fn ingest_data(file_path: String) -> Vec<DataRecord> {
    let mut records = Vec::new()
    let file_content = read_file(file_path)
    for line in file_content.lines() {
        let fields = line.split(',')
        if fields.len() == 3 {
            let record = DataRecord {
                id: fields[0].trim().parse::<i32>().unwrap(),
                name: fields[1].trim().to_string(),
                value: fields[2].trim().parse::<f64>().unwrap(),
            }
            records.push(record)
        }
    }
    records
}
