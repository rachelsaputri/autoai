MAIN = (0)

%INCLUDE 'LIB$(BLISS):BLISS.INC';
%INCLUDE 'PROC$(BLISS):PROCESS.INC';
%INCLUDE 'SYMS$(BLISS):BLISS.SYM';

INCLUDE 'parser.bliss', 'validator.bliss', 'transformer.bliss', 'reporter.bliss';

BEGIN MAIN;

    DECLARE
        status BINARY FIXED(31);
        input_path CHARACTER(256);
        output_path CHARACTER(256);

    ! Initialize system
    CALL INIT_SYSTEM();

    ! Get command line arguments
    CALL GET_ARGS(input_path, output_path);

    ! Validate inputs
    IF input_path = '' OR output_path = '' THEN
        CALL PRINT_USAGE();
        RETURN;
    END IF;

    ! Process data pipeline
    CALL PROCESS_DATA(input_path, output_path, status);

    ! Exit with status
    CALL EXIT(status);

END MAIN;
