# Configuration for Text Formatting Cleaner

# Input directory
INPUT_DIR=./data/input

# Output directory
OUTPUT_DIR=./data/output

# Log file
LOG_FILE=./data/cleaning.log

# CSV configuration
CSV_DELIMITER=,
CSV_SKIP_HEADER=false
CSV_REMOVE_DUPLICATES=true

# JSON configuration
JSON_INDENT=2
JSON_REMOVE_TRAILING_COMMAS=true

# Text configuration
TEXT_REMOVE_LEADING_WHITESPACE=true
TEXT_REMOVE_TRAILING_WHITESPACE=true
TEXT_REMOVE_EMPTY_LINES=true
TEXT_NORMALIZE_SPACES=true

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=[%timestamp%] [%level%] %message%

# Error handling
ERROR_ACTION=CONTINUE
ERROR_LOG=./data/errors.log
