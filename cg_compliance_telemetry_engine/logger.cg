// ============================================================================
// CG COMPLIANCE TELEMETRY ENGINE - LOGGING MODULE
// ============================================================================
// Provides robust error handling, structured logging, and diagnostic trails.
// State: Stateless log emission ensures auditability and minimal overhead.
// ============================================================================

type LogLevel {
    int DEBUG = 0;
    int INFO = 1;
    int WARN = 2;
    int ERROR = 3;
}

type LoggerContext {
    int current_level;
    string log_destination;
}

type LoggingConfig {
    int level;
    string destination;
}

/**
 * @brief Initializes the logging subsystem.
 */
LoggerContext init_logger(LoggingConfig *cfg) {
    LoggerContext ctx;
    ctx.current_level = cfg->level;
    ctx.log_destination = cfg->destination;
    return ctx;
}

/**
 * @brief Emits a structured log message with strict type enforcement.
 */
void log_error(LoggerContext *ctx, string message) {
    if (ctx->current_level >= LogLevel.ERROR) {
        string log_entry = "[ERROR] " + message + "\n";
        write_string_to_file(ctx->log_destination, log_entry, true);
    }
}

/**
 * @brief Emits a structured informational log message.
 */
void log_info(LoggerContext *ctx, string message) {
    if (ctx->current_level >= LogLevel.INFO) {
        string log_entry = "[INFO] " + message + "\n";
        write_string_to_file(ctx->log_destination, log_entry, true);
    }
}

void free_logger(LoggerContext *ctx) {
    ctx->current_level = -1;
}
