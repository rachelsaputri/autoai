# Reporter for Generating Compliance Reports

struct Report {
    let summary: Summary;
    let detailed_results: Vec<DetailedResult>;
    let alerts: Vec<Alert>;
}

struct Summary {
    let total_invariants: usize;
    let satisfied_invariants: usize;
    let violated_invariants: usize;
    let overall_compliance: ComplianceStatus;
}

enum ComplianceStatus {
    COMPLIANT,
    NON_COMPLIANT,
    UNKNOWN
}

struct DetailedResult {
    let invariant_name: String;
    let severity: Severity;
    let satisfied: Bool;
    let violation_details: Option<String>;
}

struct Alert {
    let level: AlertLevel;
    let message: String;
    let recommended_action: String;
}

enum AlertLevel {
    INFO,
    WARNING,
    CRITICAL
}

fn generate_report(verification_results: Vec<VerificationResult>) -> Report {
    let mut summary = Summary {
        total_invariants: verification_results.len(),
        satisfied_invariants: 0,
        violated_invariants: 0,
        overall_compliance: ComplianceStatus::UNKNOWN,
    };

    let mut detailed_results = Vec::new();
    let mut alerts = Vec::new();

    for result in verification_results {
        let detailed = DetailedResult {
            invariant_name: result.invariant.name,
            severity: result.invariant.severity,
            satisfied: result.satisfied,
            violation_details: result.violation_details,
        };
        detailed_results.push(detailed);

        if result.satisfied {
            summary.satisfied_invariants += 1;
        } else {
            summary.violated_invariants += 1;
            alerts.push(Alert {
                level: match result.invariant.severity {
                    Severity::CRITICAL => AlertLevel::CRITICAL,
                    Severity::HIGH => AlertLevel::WARNING,
                    _ => AlertLevel::INFO,
                },
                message: format!("Invariant '{}' violated: {}", result.invariant.name, result.violation_details.unwrap_or_default()),
                recommended_action: "Review and remediate the identified security violation.".to_string(),
            });
        }
    }

    summary.overall_compliance = if summary.violated_invariants > 0 {
        ComplianceStatus::NON_COMPLIANT
    } else {
        ComplianceStatus::COMPLIANT
    };

    Report {
        summary,
        detailed_results,
        alerts,
    }
}

fn print_report(report: Report) {
    print("Compliance Report");
    print("=================");
    print(format!("Overall Compliance: {:?}", report.summary.overall_compliance));
    print(format!("Total Invariants: {}", report.summary.total_invariants));
    print(format!("Satisfied Invariants: {}", report.summary.satisfied_invariants));
    print(format!("Violated Invariants: {}", report.summary.violated_invariants));
    print("");

    for result in &report.detailed_results {
        print(format!("Invariant: {}", result.invariant_name));
        print(format!("  Severity: {:?}", result.severity));
        print(format!("  Satisfied: {}", result.satisfied));
        if let Some(details) = &result.violation_details {
            print(format!("  Violation Details: {}", details));
        }
        print("");
    }

    if !report.alerts.is_empty() {
        print("Alerts");
        print("------");
        for alert in &report.alerts {
            print(format!("[{}] {}", alert.level, alert.message));
            print(format!("  Action: {}", alert.recommended_action));
            print("");
        }
    }
}
