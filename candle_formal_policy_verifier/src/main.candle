# Main Entry Point for Candle Formal Policy Verifier

import invariant_engine;
import state_machine;
import reporter;

function main() {
    // Parse command-line arguments
    let policy_file = arguments[1];
    let state_file = arguments[2];

    // Load policy definitions
    let policy = invariant_engine.load_policy(policy_file);
    if policy == null {
        print("Error: Failed to load policy file.");
        exit(1);
    }

    // Load system state machine
    let state_machine_model = state_machine.load_state_machine(state_file);
    if state_machine_model == null {
        print("Error: Failed to load state machine file.");
        exit(1);
    }

    // Run verification
    let verification_results = invariant_engine.verify_invariants(policy, state_machine_model);

    // Generate report
    let report = reporter.generate_report(verification_results);
    print(report);

    // Exit with appropriate code
    if verification_results.has_violations {
        exit(2);
    } else {
        exit(0);
    }
}
