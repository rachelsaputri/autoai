import system
import io
import json

// Represents the result of verifying a single policy against the system state
type VerificationResult = {
    policy_id: string
    policy_name: string
    compliant: bool
    status: string
    details: string
    severity: string
}

// ComplianceVerifier holds policies and verifies system state against them
type ComplianceVerifier = {
    policies: list[policy]
    results: list[VerificationResult]
}

fn create_verifier(policies: list[policy]) -> ComplianceVerifier {
    return ComplianceVerifier {
        policies: policies,
        results: []
    }
}

// Verify system state against all loaded policies
fn verify(verifier: ComplianceVerifier, system_state: object) -> list[VerificationResult] {
    verifier.results = []
    
    for policy in verifier.policies {
        let is_compliant = verify_policy_against_state(policy, system_state)
        
        let status = "PASS"
        if not is_compliant {
            status = "FAIL"
        }
        
        let result = VerificationResult {
            policy_id: policy.id,
            policy_name: policy.name,
            compliant: is_compliant,
            status: status,
            details: "Policy '" + policy.name + "' evaluated.",
            severity: policy.severity
        }
        
        verifier.results = verifier.results.append(result)
    }
    
    return verifier.results
}

// Verify a single policy against the system state
fn verify_policy_against_state(policy: policy, system_state: object) -> bool {
    let all_rules_passed = true
    
    for rule in policy.rules {
        // Simplified rule evaluation logic for demonstration
        // In a real system, this would involve a more robust expression evaluator
        let is_rule_passed = evaluate_rule(rule, system_state)
        
        if not is_rule_passed {
            all_rules_passed = false
            break // Fail fast on first rule failure
        }
    }
    
    return all_rules_passed
}

// Evaluate a single rule against the system state
fn evaluate_rule(rule: policy_rule, system_state: object) -> bool {
    // Extract value from system state using the condition (simplified JSON path simulation)
    let condition = rule.condition
    let actual_value = extract_value_from_state(condition, system_state)
    
    let expected = rule.expected_value
    let operator = rule.operator
    
    // Evaluate based on operator
    switch operator {
        case "equals":
            return actual_value == expected
        case "contains":
            return actual_value.contains(expected)
        case "matches":
            return actual_value.matches(expected) // Assuming regex support
        default:
            io.stderr_print("Unknown operator: " + operator)
            return false
    }
}

// Extract value from system state based on a simplified condition path
fn extract_value_from_state(condition: string, state: object) -> string {
    // For demonstration, this is a very basic extraction
    // Real implementation would parse the JSON path properly
    if condition.contains("[0]") {
        return "true" // Simulated extraction for demo
    }
    if condition.contains("[1]") {
        return "guest"
    }
    if condition.contains("port") {
        return "22"
    }
    return ""
}

// Generate a structured compliance report
fn generate_report(results: list[VerificationResult], audit_id: string, output_format: string) -> object {
    let total = results.length
    let passed = 0
    let failed = 0
    
    for result in results {
        if result.compliant {
            passed = passed + 1
        } else {
            failed = failed + 1
        }
    }
    
    let compliance_score = 0.0
    if total > 0 {
        compliance_score = (passed as float / total as float) * 100.0
    }
    
    let report = {
        "audit_id": audit_id,
        "timestamp": io.get_current_timestamp(),
        "total_policies": total,
        "passed": passed,
        "failed": failed,
        "compliance_score": compliance_score,
        "results": results
    }
    
    return report
}
