 */

set DOMAINS := FINANCIAL PRIVACY INFRASTRUCTURE ACCESS;

set CONTROLS := ENCRYPTION MFA MONITORING AUDIT_PATCHING NETWORK_SEGMENTATION BACKUP_RECOVERY;

set SCENARIOS := BREACH FAILURE COMPLIANCE_DRIFT;

param risk_score :=
    FINANCIAL 85
    PRIVACY 72
    INFRASTRUCTURE 65
    ACCESS 90;

param compliance_weight :=
    FINANCIAL 0.35
    PRIVACY 0.25
    INFRASTRUCTURE 0.20
    ACCESS 0.20;

param control_effectiveness :=
    /*          ENCRYPTION MFA MONITORING AUDIT_PATCHING NETWORK_SEGMENTATION BACKUP_RECOVERY */
    FINANCIAL       0.8   0.3     0.5          0.6                0.2                 0.4
    PRIVACY         0.7   0.4     0.6          0.5                0.3                 0.3
    INFRASTRUCTURE  0.6   0.5     0.7          0.8                0.9                 0.7
