param implementation_cost :=
    /*          ENCRYPTION MFA MONITORING AUDIT_PATCHING NETWORK_SEGMENTATION BACKUP_RECOVERY */
    FINANCIAL       50    30      40           35                 25                  20
    PRIVACY         45    25      35           30                 20                  15
    INFRASTRUCTURE  60    40      55           50                 70                  45
    ACCESS          35    45      40           30                 25                  25;

param mandatory_coverage :=
    FINANCIAL 0.6
    PRIVACY 0.5
    INFRASTRUCTURE 0.7
    ACCESS 0.8;

param threshold_violation :=
    FINANCIAL 20
    PRIVACY 15
    INFRASTRUCTURE 18
    ACCESS 12;

param budget_limit := 200;

param scenario_weight :=
    BREACH 0.4
    FAILURE 0.3
    COMPLIANCE_DRIFT 0.3;

param mandatory_controls :=
    FINANCIAL ENCRYPTION AUDIT_PATCHING
    PRIVACY ENCRYPTION MFA
    INFRASTRUCTURE NETWORK_SEGMENTATION BACKUP_RECOVERY
    ACCESS MFA MONITORING;

param ACTIVE_CONTROLS :=
    {(d,c) in FINANCIAL ENCRYPTION, FINANCIAL MFA, FINANCIAL MONITORING,
     FINANCIAL AUDIT_PATCHING, FINANCIAL NETWORK_SEGMENTATION, FINANCIAL BACKUP_RECOVERY,
     PRIVACY ENCRYPTION, PRIVACY MFA, PRIVACY MONITORING,
     PRIVACY AUDIT_PATCHING, PRIVACY NETWORK_SEGMENTATION, PRIVACY BACKUP_RECOVERY,
