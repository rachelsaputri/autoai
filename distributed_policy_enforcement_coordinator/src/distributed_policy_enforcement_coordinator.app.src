{application, distributed_policy_enforcement_coordinator,
 [{description, "Distributed Policy Enforcement Coordinator"},
  {vsn, "1.0.0"},
  {modules, [dpe_coord,
             dpe_policy_sync,
             dpe_health_monitor,
             main]},
  {registered, [dpe_coord,
               dpe_policy_sync,
               dpe_health_monitor]},
  {applications, [kernel,
                  stdlib]},
  {mod, {main, []}},
  {env, [{policy_dir, "/etc/policies"},
         {cluster_nodes, []}]}]}.
