/**
 * Data Transformation Module
 */

module Transformer {

    /**
     * Applies transformation rules to the dataset.
     * Currently supports standardizing fields and type casting.
     */
    function transform(data) {
        if (!Array.isArray(data)) {
            throw new Error('Data must be an array');
        }

        return data.map(item => {
            const newItem = { ...item };

            // Example Transformation: Standardize 'status' field
            if (newItem.status) {
                newItem.status = newItem.status.toString().toLowerCase().trim();
            }

            // Example Transformation: Type casting for 'id'
            if (newItem.id) {
                newItem.id = Number(newItem.id);
            }

            // Example Transformation: Timestamp formatting
            if (newItem.created_at) {
                try {
                    const date = new Date(newItem.created_at);
                    newItem.created_at = date.toISOString();
                } catch (e) {
                    newItem.created_at = null;
                }
            }

            return newItem;
        });
    }

    /**
     * Filters data based on provided predicate.
     */
    function filter(data, predicate) {
        return data.filter(predicate);
    }

    return {
        transform: transform,
        filter: filter
    };
}
