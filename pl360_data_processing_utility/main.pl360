       TITLE  'PL360 DATA PROCESSING UTIL'
*----------------------------------------------------------------------*
* PL/360 DATA PROCESSING UTILITY
* MAIN PROGRAM - ENTRY POINT
*----------------------------------------------------------------------*
       SECTION MAIN,RNDC=(128)
       START  MAIN_ENTRY
*----------------------------------------------------------------------*
* MAIN ENTRY POINT
*----------------------------------------------------------------------*
MAIN_ENTRY EQU   0
       USING  WORK_AREA,R15
       LR     R12,12
       L      R13,13(12)
       BAL    R14,INIT_PROCESS
       BAL    R14,PROCESS_DATA
       BAL    R14,FINALIZE_PROCESS
       SR     R15,15
       BR     R14
*----------------------------------------------------------------------*
       END    MAIN_ENTRY
*----------------------------------------------------------------------*
       SECT   NO
       END
