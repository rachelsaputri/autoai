"_sys.define(:bigint) := _class_new(_bigint, _parent: _object, _properties: [:value])\n\ndefine _bigint._init(self, value_01)\n  self.value := value_01\n  _return()\nend\n\ndefine _bigint._new(self, value_01)\n  _return(_bigint._init(_object_new(_bigint), value_01))\nend\n\ndefine _bigint._add(self, other)\n  _return(_bigint._new(self.value + other.value))\nend\n\ndefine _bigint._mul(self, other)\n  _return(_bigint._new(self.value * other.value))\nend\n\ndefine _bigint._mod(self, other)\n  _return(_bigint._new(self.value % other.value))\nend\n\ndefine _bigint._eq(self, other)\n  _return(self.value == other.value)\nend\n\ndefine _bigint._lt(self, other)\n  _return(self.value < other.value)\nend\n\ndefine _bigint._toString(self)\n  _return(_format(self.value))\nend\n\ndefine _bigint._hashCode(self)\n  _return(self.value._hashCode)\nend\n\ndefine _bigint._toHex(self)\n  _return(_format(self.value, 16))\nend\n\ndefine _bigint._fromHex(self, hex_string)\n  _return(_bigint._new(_parse_integer(hex_string, 16)))\nend\n\ndefine _bigint._fromBytes(self, byte_array)\n  _return(_bigint._new(_parse_integer(_to_string(byte_array), 256)))\nend\n\ndefine _bigint._toBytes(self)\n  _return(_to_integer_array(self.value, 256))\nend\n\n_sys.define(:point) := _class_new(_point, _parent: _object, _properties: [:x, :y])\n\ndefine _point._init(self, x, y)\n  self.x := x\n  self.y := y\n  _return()\nend\n\ndefine _point._new(self, x, y)\n  _return(_point._init(_object_new(_point), x, y))\nend\n\ndefine _point._add(self, other)\n  _return(self._dbl_add(self, other))\nend\n\ndefine _point._dbl(self)\n  _return(self._dbl_add(self, self))\nend\n\ndefine _point._neg(self)\n  _return(_point._new(self.x, self.y._neg))\nend\n\ndefine _point._eq(self, other)\n  _return((self.x._eq(other.x)) AND (self.y._eq(other.y)))\nend\n\ndefine _point._is_infinity(self)\n  _return(self.x._eq(0))\nend\n\ndefine _point._dbl_add(self, p1, p2)\n  IF p1._is_infinity()\n    _return(p2)\n  END\n  IF p2._is_infinity()\n    _return(p1)\n  END\n  \\n  IF p1.x._eq(p2.x)\n    IF p1.y._eq(p2.y)\n      RETURN self._dbl(p1)\n    END\n    RETURN _sys.curve.infinity\n  END\n  \\n  define slope := ((p2.y._sub(p1.y))._mul(((p2.x._sub(p1.x))._mod_inv(p1.x.curve.p))))\n  define x3 := ((slope._mul(slope))._sub(p1.x._add(p2.x)))._mod(p1.x.curve.p)\n  define y3 := ((slope._mul(p1.x._sub(x3)))._sub(p1.y))._mod(p1.x.curve.p)\n  RETURN _point._new(x3, y3)\nend\n","filepath":"./mag_ecc_crypto_toolkit/ec_math.mag"},{"content":"_sys.define(:ecdsa) := _class_new(_ecdsa, _parent: _object, _properties: [:n, :p, :a, :b, :Gx, :Gy, :infinity])\n\ndefine _ecdsa._init(self, name, p, a, b, n, Gx, Gy)\n  self.name := name\n  self.p := _bigint._new(p)\n  self.a := _bigint._new(a)\n  self.b := _bigint._new(b)\n  self.n := _bigint._new(n)\n  self.Gx := _bigint._new(Gx)\n  self.Gy := _bigint._new(Gy)\n  self.infinity := _point._new(_bigint._new(0), _bigint._new(0))\n  _return()\nend\n\ndefine _ecdsa._new(self, name, p, a, b, n, Gx, Gy)\n  _return(_ecdsa._init(_object_new(_ecdsa), name, p, a, b, n, Gx, Gy))\nend\n\ndefine _ecdsa._public_key(self, privkey)\n  RETURN self._scalar_mul(self.G, privkey)\nend\n\ndefine _ecdsa._sign(self, message, privkey)\n  define k := _generate_random_k(self.n)\n  define r := self._scalar_mul(self.G, k).x\n  define s := ((r._mul(privkey))._add(_hash(message)))._mul(k._mod_inv(self.n))\n  RETURN _signature._new(r, s)\nend\n\ndefine _ecdsa._verify(self, message, signature, pubkey)\n  define w := signature.s._mod_inv(self.n)\n  define u1 := (_hash(message))._mul(w)\n  define u2 := signature.r._mul(w)\n  define point := self._scalar_add(self._scalar_mul(self.G, u1), self._scalar_mul(pubkey, u2))\n  _return(signature.r._eq(point.x))\nend\n\ndefine _ecdsa._scalar_mul(self, point, scalar)\n  define result := self.infinity\n  define temp := point\n  WHILE scalar > 0\n    IF (scalar % 2) == 1\n      result := result._add(temp)\n    END\n    temp := temp._add(temp)\n    scalar := scalar / 2\n  END\n  _return(result)\nend\n\ndefine _ecdsa._scalar_add(self, p1, p2)\n  RETURN p1._add(p2)\nend\n\ndefine _ecdsa._G(self)\n  RETURN _point._new(self.Gx, self.Gy)\nend\n\ndefine _ecdsa._hash(self, message)\n  define hash_bytes := _sha256(message)\n  define hash_int := _bytes_to_int(hash_bytes)\n  RETURN _bigint._new(hash_int)\nend\n","filepath":"./mag_ecc_crypto_toolkit/ecdsa.mag"},{"content":"define _create_secp256k1()\n  _return(_ecdsa._new(\n    'secp256k1',\n    0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F,\n    0, 7,\n    0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141,\n    0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,\n    0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8\n  ))\nend\n\ndefine _generate_private_key(curve)\n  define max := curve.n.value - 1\n  define rand := _random(0, max)\n  _return(_bigint._new(rand))\nend\n\ndefine _generate_random_k(n)\n  define max := n.value - 1\n  define rand := _random(1, max)\n  _return(_bigint._new(rand))\nend\n\ndefine _random(min, max)\n  _return(_sys.random(max) % (max - min + 1) + min)\nend\n\ndefine _sha256(message)\n  _return(_crypto_hash(_hashlib_sha256, message))\nend\n\ndefine _bytes_to_int(bytes)\n  define result := 0\n  FOR byte IN bytes\n    result := (result << 8) + byte\n  END\n  _return(result)\nend\n\ndefine _parse_integer(string, base)\n  _return(string.to_integer(base))\nend\n\ndefine _to_integer_array(value, base)\n  define result := []\n  WHILE value > 0\n    result.prepend(value % base)\n    value := value / base\n  END\n  _return(result)\nend\n\ndefine _to_string(byte_array)\n  define str := ''\n  FOR byte IN byte_array\n    str := str + _chr(byte)\n  END\n  _return(str)\nend\n\ndefine _chr(byte)\n  _return(_string.char(byte))\nend\n\ndefine _string_char(byte)\n  _return(_string.from_char(byte))\nend\n","filepath":"./mag_ecc_crypto_toolkit/ec_utils.mag"},{"content":"_sys.define(:signature) := _class_new(_signature, _parent: _object, _properties: [:r, :s])\n\ndefine _signature._init(self, r, s)\n  self.r := r\n  self.s := s\n  _return()\nend\n\ndefine _signature._new(self, r, s)\n  _return(_signature._init(_object_new(_signature), r, s))\nend\n\ndefine _signature._toString(self)\n  _return('r: ' + self.r._toString() + ', s: ' + self.s._toString())\nend\n","filepath":"./mag_ecc_crypto_toolkit/ec_types.mag"}]}]
