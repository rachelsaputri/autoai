        MODE THREAT_INTEL = RECORD
            STRING indicator, type, confidence, context, severity
        END;

        MODE REMEDIATION_ACTION = RECORD
            STRING rule_id, current_value, target_value, command, rollback_command
        END;

        MODE NOTIFICATION = RECORD
            STRING recipient, channel, subject, body, priority
        END;

        MODE SESSION = RECORD
            STRING id, user, role, start_time, end_time, status
        END;

        MODE CONFIGURATION_ITEM = RECORD
            STRING id, name, type, value, owner, last_modified
        END;

        MODE SECURITY_CONTROL = RECORD
            STRING id, description, category, effectiveness, status
        END;

        MODE VULNERABILITY = RECORD
            STRING id, severity, description, affected_systems, remediation
