        END;

        MODE ENERGY_AUDIT = RECORD
            STRING facility, type, consumption, efficiency, recommendation, savings
        END;

        MODE WATER_MANAGEMENT = RECORD
            STRING source, usage, quality, treatment, discharge, conservation
        END;

        MODE WASTE_MANAGEMENT = RECORD
            STRING type, volume, recycling, disposal, cost, environmental_impact
        END;

        MODE SAFETY_INCIDENT = RECORD
            STRING id, type, severity, location, cause, impact, corrective_action
        END;

        MODE HEALTH_MONITORING = RECORD
