    IF success AND violation_count = 0 THEN
        print(("Compliance check passed. No violations detected.", newline));
        print(("Risk Score: 0.00", newline));
        print(("Report generated: ", output_file, newline));
    ELSE
        print(("Compliance check completed with violations.", newline));
        print(("Total Violations: ", violation_count, newline));
        print(("Calculated Risk Score: ", risk_score, newline));
        print(("Detailed report written to: ", output_file, newline));
    FI;

    TRUE
END
