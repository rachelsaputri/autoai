100 LET BASELINE_STATE = "SAFE"
110 LET CURRENT_STATE = "UNKNOWN"
120 LET DRIFT_COUNT = 0
130 INPUT "Enter current system state: ", CURRENT_STATE
140 GOTO SUBROUTINE_CHECK_DRIFT
150 REM SUBROUTINE CHECKS STATE AGAINST BASELINE
160 CHECK_DRIFT LABEL 200
170 REM MAIN LOGIC CONTINUES HERE
180 GOTO SUBROUTINE_REPORT
190 REM END OF MAIN
200 REM CHECK_DRIFT SUBROUTINE
210 IF CURRENT_STATE = BASELINE_STATE THEN 230
220 LET DRIFT_COUNT = DRIFT_COUNT + 1
230 PRINT "Drift check complete. Drift count: "; DRIFT_COUNT
240 RETURN
250 REM SUBROUTINE REPORTS RESULTS
260 REPORT LABEL 280
270 IF DRIFT_COUNT > 0 THEN 290
280 PRINT "System is compliant. No drift detected."
290 ELSE
300 PRINT "ALERT: System drift detected!"
310 PRINT "Current State: "; CURRENT_STATE
320 PRINT "Baseline State: "; BASELINE_STATE
330 PRINT "Drift Count: "; DRIFT_COUNT
340 END
350 END
