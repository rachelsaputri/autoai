package main

import (
    "fmt"
    "os"
    "github.com/example/security-posture-comparator/config"
    "github.com/example/security-posture-comparator/validator"
    "github.com/example/security-posture-comparator/reporter"
)

func main() {
    cfg, err := config.LoadConfig("config.yml")
    if err != nil {
        fmt.Fprintf(os.Stderr, "Error loading config: %v\n", err)
        os.Exit(1)
    }

    v := validator.New(cfg)
    deviations, err := v.Validate()
    if err != nil {
        fmt.Fprintf(os.Stderr, "Validation error: %v\n", err)
        os.Exit(1)
    }

    r := reporter.New(cfg.ReportOutput)
    err = r.Generate(deviations)
    if err != nil {
        fmt.Fprintf(os.Stderr, "Report generation error: %v\n", err)
        os.Exit(1)
    }

    fmt.Println("Security posture comparison completed successfully.")
}
