package config

import (
    "gopkg.in/yaml.v2"
    "os"
)

type Config struct {
    BaselineFile string `yaml:"baseline_file"`
    ReportOutput string `yaml:"report_output"`
    AuditURL     string `yaml:"audit_url"`
}

func LoadConfig(path string) (*Config, error) {
    data, err := os.ReadFile(path)
    if err != nil {
        return nil, err
    }

    var cfg Config
    err = yaml.Unmarshal(data, &cfg)
    if err != nil {
        return nil, err
    }

    return &cfg, nil
}
