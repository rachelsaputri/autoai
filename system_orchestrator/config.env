#!/usr/bin/env bash
# config.env - Environment variables and defaults for System Orchestrator

# Service names or units to manage (comma-separated)
SERVICE_LIST="telemetry_ingester,correlation_engine,response_orchestrator"

# Directories
LOG_DIR="${SCRIPT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}/logs"
ARCHIVE_DIR="${SCRIPT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}/archives"

# Hardening baseline files to check permissions on
HARDENED_FILES="/etc/shadow /etc/passwd /etc/ssh/sshd_config"

# Alert configuration (placeholder for email/PagerDuty/webhook integration)
ALERT_EMAIL="admin@example.com"
ALERT_WEBHOOK="https://hooks.example.com/security-alerts"

# Operational limits
MAX_LOG_AGE_DAYS=7
DISK_WARNING_THRESHOLD=90
