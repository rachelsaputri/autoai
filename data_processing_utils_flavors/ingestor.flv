/// Ingestor module for reading CSV files

import "types.flv"

/// Parse a CSV file into a list of records
fn parse_csv(filepath: String) -> List<Record> {
  let lines = read_lines(filepath);
  if length(lines) < 2 {
    error("File must contain a header and at least one data row.");
    return [];
  }
  
  let header = split(lines[0], ",");
  let dataLines = drop(lines, 1);
  
  map(dataLines, \(line: String) => {
    let values = split(line, ",");
    zip_with(header, values, \\(key: String, val: String) => (key, val));
  });
}

