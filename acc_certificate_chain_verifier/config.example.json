{
  "trust_roots": [
    "/etc/ssl/certs/ca-certificates.crt"
  ],
  "monitored_paths": [
    "/etc/ssl/certs",
    "/etc/apache2/ssl",
    "/var/lib/docker/certs"
  ],
  "audit_path": "/var/log/acc_cert_verifier/audit.log",
