; data_validator.lgo
; Handles data validation logic

TO CHECKSCHEMA [RECORD EXPECTEDLEN]
  IF NOT EQUALP COUNT :RECORD :EXPECTEDLEN [
    PRINT [Schema Mismatch]
    OUTPUT FALSE
  ]
  OUTPUT TRUE
END

TO CHECKNULLS [RECORD]
  FOREACH [ITEM] :RECORD [
    IF EMPTY :ITEM [
      PRINT [Null Value Detected]
      OUTPUT FALSE
    ]
  ]
  OUTPUT TRUE
END

TO VALIDATERECORD [RECORD]
  IF NOT CHECKSCHEMA :RECORD 4 [OUTPUT FALSE]
  IF NOT CHECKNULLS :RECORD [OUTPUT FALSE]
  OUTPUT TRUE
END
