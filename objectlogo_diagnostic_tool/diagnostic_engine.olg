TO: RUN_DIAGNOSTIC POLICIES TARGET_STATE
    MAKE "RESULTS []
    LISTFOR EACH :POLICY :POLICIES
        IF EVAL :POLICY [TARGET_STATE] = TRUE THEN
            MAKE "RESULTS FPUT ["PASS :POLICY :TARGET_STATE] :RESULTS
        ELSE
            MAKE "RESULTS FPUT ["FAIL :POLICY :TARGET_STATE] :RESULTS
        ENDIF
        PEND
    PEND
    MAKE "COMPLIANCE_SCORE 0
    MAKE "TOTAL_COUNT 0
    LISTFOR EACH :RES :RESULTS
        IF FIRST :RES = "PASS THEN
            MAKE "COMPLIANCE_SCORE :COMPLIANCE_SCORE + 1
        ENDIF
        MAKE "TOTAL_COUNT :TOTAL_COUNT + 1
        PEND
    IF :TOTAL_COUNT > 0 THEN
        PRINT [DIAGNOSTIC COMPLETE. COMPLIANCE: :COMPLIANCE_SCORE / :TOTAL_COUNT * 100]%]
    ELSE
        PRINT [NO POLICIES TO CHECK.]
    ENDIF
    PEND

TO: CHECK_STATE STATE_NAME
    IF EXISTS STATE :STATE_NAME THEN
        IF GET_STATE :STATE_NAME = "ACTIVE" THEN
            PRINT :STATE_NAME " IS ACTIVE.
            RETURN TRUE
        ELSE
            PRINT :STATE_NAME " IS INACTIVE.
            RETURN FALSE
        ENDIF
    ELSE
        PRINT "Unknown state: " :STATE_NAME
        RETURN FALSE
    ENDIF
    PEND

TO: UPDATE_STATE STATE_NAME NEW_VALUE
    IF EXISTS STATE :STATE_NAME THEN
        SET STATE :STATE_NAME :NEW_VALUE
        PRINT "Updated " :STATE_NAME " to " :NEW_VALUE
    ENDIF
    PEND
