CLASS Main {
  PUBLIC:
    METHOD Main(args: Array[String]) {
      diagnostic_engine := DiagnosticEngine::New()
      diagnostic_engine.Initialize()

      visualizer := Visualizer::New()

      config := Config::New(1, true)

      result1 := diagnostic_engine.RunCheck("memory", config)
      result2 := diagnostic_engine.RunCheck("cpu", config)

      results_map := diagnostic_engine.GetResults()

      visualizer.RenderResults(results_map)

      PRINT("Diagnostic complete. Processed " + visualizer.GetBufferCount().ToString() + " checks.")
    }
}

BEGIN Main::Main(Array[String>::New())
