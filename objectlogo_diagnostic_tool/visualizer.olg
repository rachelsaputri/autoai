CLASS Visualizer {
  PRIVATE:
    RESULTS_BUFFER: List[DiagnosticResult]
  PUBLIC:
    METHOD New() {
      RESULTS_BUFFER := List<DiagnosticResult>::New()
    }

    METHOD RenderResults(results: Map[String, DiagnosticResult]) {
      FOR EACH check_name IN results.KeySet() DO {
        result := results[check_name]
        this.AppendToBuffer(result)
        PRINT("[" + result.GetStatus() + "] " + result.GetCheckName() + ": " + result.GetMessage())
      }
    }

    METHOD AppendToBuffer(result: DiagnosticResult) {
      RESULTS_BUFFER.Add(result)
    }

    METHOD GetBufferCount(): Integer {
      RETURN RESULTS_BUFFER.Count()
    }
}
