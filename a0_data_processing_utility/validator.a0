// Data validation checks for A-0 Data Processing Utility

// Validate the current data set
FUNCTION ValidateData()
    // Check if data_length is zero
    IF data_length == 0 THEN
        Log("No data to validate.")
        RETURN FALSE
    END_IF

    DECLARE i: INTEGER

    // Validate each record
    FOR i := 0 TO data_length - 1 DO
        // Check for negative IDs
        IF current_data[i].id < 0 THEN
            Log("Invalid ID at index " + TO_STRING(i))
            RETURN FALSE
        END_IF

        // Check for missing timestamps
        IF current_data[i].timestamp == 0 THEN
            Log("Missing timestamp at index " + TO_STRING(i))
            RETURN FALSE
        END_IF
    END_FOR

    Log("Data validation passed.")
    RETURN TRUE
END_FUNCTION
