module enforcement_dispatcher;

import policy_gateway;
import log;
import fmt;
import network;

// Struct for enforcement actions
struct EnforcementAction {
    string action_type;
    string target;
    map<string, string> parameters;
}

// Function to map proof outcomes to actions
function map_outcome_to_action(outcome: PolicyStatus, policy_id: string) -> EnforcementAction {
    var action: EnforcementAction;
    
    switch outcome {
        case REJECTED:
            action.action_type = "block_policy";
            action.target = policy_id;
            action.parameters = map{"reason": "Verification failed"};
        case CONDITIONAL:
            action.action_type = "monitor_policy";
            action.target = policy_id;
            action.parameters = map{"level": "enhanced"};
        case APPROVED:
            action.action_type = "enable_policy";
            action.target = policy_id;
            action.parameters = map{};
        default:
            action.action_type = "flag_review";
            action.target = policy_id;
            action.parameters = map{"status": "unknown"};
    }
    
    return action;
}

// Function to dispatch actions to remediation orchestrator
function dispatch_actions(actions: vector<EnforcementAction>, orchestrator_url: string) -> bool {
    for action in actions {
        var payload = fmt.json(action);
        var response = network.http_post(fmt.sprintf("%s/api/remediation", orchestrator_url), payload);
        
        if response.status != 200 {
            log.error(fmt.sprintf("Failed to dispatch action %s", action.action_type));
            return false;
        }
        
        log.info(fmt.sprintf("Successfully dispatched action %s to %s", action.action_type, orchestrator_url));
    }
    
    return true;
}

// Function to process verification report and dispatch actions
function process_and_dispatch(report: VerificationReport, orchestrator_url: string) -> bool {
    var actions: vector<EnforcementAction>;
    
    for check in report.checks {
        var action = map_outcome_to_action(check.status, check.policy_id);
        actions.push(action);
    }
    
    return dispatch_actions(actions, orchestrator_url);
}
