import "pipeline_engine.cv"
import "config.json"

fn main() {
    print("Starting CorVision Data Processing Utility...")
    
    // Load configuration
    var config = load_config("config.json")
    
    // Initialize pipeline engine
    var engine = new PipelineEngine(config)
    
    // Execute pipeline
    engine.execute()
    
    print("Data processing completed successfully.")
}
