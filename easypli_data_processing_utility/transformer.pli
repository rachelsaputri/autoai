     TRANSFORM_DATA MODULE(DATA_RECORD);

     /* TRANSFORM DATA MODULE */
     DECLARE DATA_RECORD CHARACTER(100);
     DECLARE TRANSFORMED_RECORD CHARACTER(100);

     /* APPLY TRANSFORMATIONS */
     TRANSFORMED_RECORD = TO_UPPER(DATA_RECORD);
     /* ADD MORE TRANSFORMATIONS AS NEEDED */

     /* UPDATE DATA_RECORD */
     DATA_RECORD = TRANSFORMED_RECORD;

     END TRANSFORM_DATA;
