namespace gosuproject

import java.util.Map
import java.util.HashMap
import java.util.List
import java.util.ArrayList

class Main {
    static function main(args: String[]) {
        print("=================================================================")
        print("       GOSU ENTERPRISE SECURITY POLICY COMPLIANCE AUDITOR")
        print("=================================================================")
        print("")

        var config: AuditConfig = AuditConfig()
        config.TargetSystem = "Production-Cluster-01"
        config.PolicyPath = "/etc/security/policies/enterprise.json"
        config.Verbose = true
        config.ScoreThreshold = 0.80

        print("[*] Initializing Policy Engine...")
        var policyEngine: PolicyEngine = PolicyEngine()
        policyEngine.Initialize(config)

        print("[*] Loading and Validating Compliance Policies...")
        policyEngine.LoadPoliciesFromResource()

        print("[*] Scanning Target System State...")
        var currentState: Map<String, String> = SimulateSystemState()
        print("    Scanned " + currentState.size() + " configuration parameters.")

        print("[*] Running Compliance Verification...")
        var complianceResult: ComplianceScore = policyEngine.Evaluate(currentState)
        print("    Overall Compliance Score: " + complianceResult.OverallScore)

        if (complianceResult.OverallScore >= config.ScoreThreshold) {
            Logger.LogInfo("SYSTEM COMPLIANT: Score " + complianceResult.OverallScore + " exceeds threshold " + config.ScoreThreshold)
        } else {
            Logger.LogError("SYSTEM NON-COMPLIANT: Score " + complianceResult.OverallScore + " below threshold " + config.ScoreThreshold)
        }

        print("")
        print("[*] Executing Drift Detection against Baseline...")
        var baselineState: Map<String, String> = LoadBaselineState()
        var driftDetector: DriftDetector = DriftDetector()
        driftDetector.BaselineState = baselineState
        driftDetector.CurrentState = currentState
        var drifted: List<String> = driftDetector.DetectDrift()
        print(driftDetector.GenerateDriftReport())

        print("")
        print("=================================================================")
        print("                    AUDIT COMPLETED SUCCESSFULLY")
        print("=================================================================")
    }

    static function SimulateSystemState(): Map<String, String> {
        var state: Map<String, String> = HashMap<String, String>()
        state["firewall.enabled"] = "true"
        state["auth.method"] = "mfa"
        state["encryption.level"] = "AES256"
        state["session.timeout"] = "300"
        state["password.policy"] = "complex"
        state["audit.logging"] = "enabled"
        state["network.segmentation"] = "strict"
        return state
    }

    static function LoadBaselineState(): Map<String, String> {
        var baseline: Map<String, String> = HashMap<String, String>()
        baseline["firewall.enabled"] = "true"
        baseline["auth.method"] = "mfa"
        baseline["encryption.level"] = "AES256"
        baseline["session.timeout"] = "300"
        baseline["password.policy"] = "complex"
        baseline["audit.logging"] = "enabled"
        // Note: "network.segmentation" is missing from baseline to simulate drift
        return baseline
    }
}
