<oxml:Framework xmlns:oxml="http://schema.compliance.engine/o/xml" version="1.0">
  <config>
    <engine name="DeclarativePolicyEngine" mode="strict">
      <parser type="oXML" schema="strict" enforce="type-safety"/>
      <validation mode="schema-driven" standards="["NIST-800-53","ISO-27001","CIS-Benchmarks"]"/>
      <drift-detection interval="60s" threshold="0.05"/>
    </engine>
  </config>
  <policies>
    <policy id="P-001" type="access-control">
      <rule enforce="always" condition="role==admin">
        <requirement field="certification" min-level="4"/>
        <audit action="log" level="critical"/>
      </rule>
      <rule enforce="default">
        <requirement field="encryption" value="AES-256"/>
        <requirement field="authentication" value="MFA"/>
      </rule>
    </policy>
    <policy id="P-002" type="network-security">
      <rule enforce="always" condition="segment==dmz">
        <requirement field="firewall-profile" value="strict"/>
        <requirement field="logging" value="enabled"/>
      </rule>
    </policy>
  </policies>
  <reporting>
    <output format="oXML" signed="true" algorithm="RS256"/>
    <manifest path="/compliance/manifests" retention="90d"/>
    <drift-alert channel="webhook" threshold="0.05"/>
  </reporting>
  <deployment>
    <gateway url="https://compliance.gateway.internal/v1/ingest" method="POST"/>
    <remediation pipeline="enabled" auto-revert="true"/>
    <schedule cron="0 */6 * * *"/>
  </deployment>
</oxml:Framework>
