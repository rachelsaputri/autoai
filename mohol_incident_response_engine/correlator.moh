import logger;

function init() {
    logger.log("DEBUG", "Correlator module initialized");
}

function correlate(incidents) {
    let threats = [];
    let threat_map = {};
    
    for each incident in incidents {
        let key = incident.type;
        if (key in threat_map) {
            threat_map[key].count += 1;
        } else {
            threat_map[key] = {
                "type": incident.type,
                "count": 1,
                "details": [incident]
            };
        }
    }
    
    for each key in threat_map.keys() {
        let threat = threat_map[key];
        if (threat.count >= 3) {
            threats.push(threat);
            logger.log("WARN", format("High severity threat detected: {}", threat.type));
        }
    }
    
    return threats;
}
