MODULE reporter;
IMPORTS verifier, fileio, strings;

PROCEDURE GenerateReport(results: ARRAY OF ValidationResult, filename: STRING);
VAR
  output: STRING;
  i: INTEGER;
BEGIN
  output := "Compliance Verification Report\n";
  output := output + "==============================\n";
  
  FOR i := 0 TO results.len - 1 DO
    output := output + "Rule ID: ", results[i].policyId, "\n";
    output := output + "Status: ", IF results[i].compliant THEN "PASS" ELSE "FAIL" END, "\n";
    output := output + "Details: ", results[i].message, "\n";
    output := output + "--------------------------\n";
  END;
  
  fileio.WriteText(filename, output);
END GenerateReport;

END reporter.
