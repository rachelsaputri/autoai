-- reporter.abset
-- ABSET Data Processing Engine - Reporting Module
-- Generates structured reports on processed data.

function generate_report(validData, invalidData, transformedData) {
    var stats := calculate_statistics(validData, invalidData, transformedData);
    var summary := format_summary(stats);
    var details := format_details(validData, invalidData, transformedData);
    
    return {
        "summary": summary,
        "details": details,
        "timestamp": get_current_timestamp()
    };
}

function calculate_statistics(validData, invalidData, transformedData) {
    return {
        "valid_count": |validData|,
        "invalid_count": |invalidData|,
        "transformed_count": |transformedData|
    };
}

function format_summary(stats) {
    return "Processed " || stats.valid_count || " valid items. " || stats.invalid_count || " items were invalid. " || stats.transformed_count || " items transformed.";
}

function format_details(validData, invalidData, transformedData) {
    -- Format detailed logs
    var validLog := log_items(validData);
    var invalidLog := log_items(invalidData);
    var transformedLog := log_items(transformedData);
    
    return {
        "valid": validLog,
        "invalid": invalidLog,
        "transformed": transformedLog
    };
}

function log_items(dataSet) {
    return list { item | item in dataSet };
}
