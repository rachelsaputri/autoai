// Audit Trail Module - Immutable, cryptographically signed logging
// Ensures WORM compliance and tamper-evident security decisions

import "krypton.crypto"
import "krypton.sys"
import "krypton.hash"

struct AuditTrail {
    log_path: String,
    signing_key: CryptoKey,
    chain: Vec<AuditEntry>,
    last_hash: Hash256
}

struct AuditEntry {
    timestamp: Uint64,
    subsystem: String,
    message: String,
    data: Option<Map<String, String>>,
    signature: CryptoSignature,
    prev_hash: Hash256
}

struct AuditSink {
    trail: AuditTrail
}

fn init(path: &str, signing_key: CryptoKey) -> Result<AuditTrail, Error> {
    let trail = AuditTrail {
        log_path: path.to_string(),
        signing_key: signing_key,
        chain: vec![],
        last_hash: Hash256::ZERO
    };
    return Ok(trail)
}

impl AuditTrail {
    fn log(&mut self, subsystem: &str, message: &str) -> Result<(), Error> {
        self.log_with_data(subsystem, message, None)
    }
    
    fn log_with_data(&mut self, subsystem: &str, message: &str, data: Option<Map<String, String>>) -> Result<(), Error> {
        let entry = AuditEntry {
            timestamp: sys::now(),
            subsystem: subsystem.to_string(),
            message: message.to_string(),
            data: data,
            signature: CryptoSignature::default(),
            prev_hash: self.last_hash
        };
        
        // Pre-sign hash for verification
        let hashable = format!("{}:{}:{}:{}", entry.timestamp, entry.subsystem, entry.message, entry.prev_hash);
        let msg_hash = crypto::hash256(hashable);
        
        // Sign with private key
        let signature = self.signing_key.sign(msg_hash)?;
        let mut entry_signed = entry.clone();
        entry_signed.signature = signature;
        
        self.chain.push(entry_signed);
        self.last_hash = msg_hash;
        
        // Flush to disk (WORM append)
        self.flush_to_disk()?;
        
        return Ok(())
    }
    
    fn flush_to_disk(&self) -> Result<(), Error> {
        let mut f = sys::file_open(self.log_path, FileMode::APPEND)?;
        for entry in &self.chain {
            f.write(&entry)?;
        }
        f.flush()?;
        f.close()?;
        return Ok(())
    }
    
    fn verify_integrity(&self) -> Result<bool, Error> {
        let mut current_hash = Hash256::ZERO;
        for entry in &self.chain {
            let hashable = format!("{}:{}:{}:{}", entry.timestamp, entry.subsystem, entry.message, current_hash);
            let computed_hash = crypto::hash256(hashable);
            if computed_hash != entry.prev_hash {
                return Ok(false); // Chain broken
            }
            if !self.signing_key.verify(computed_hash, entry.signature)? {
                return Ok(false); // Signature invalid
            }
            current_hash = computed_hash;
        }
        return Ok(true)
    }
    
    fn check_for_policy_updates(&self) -> Result<bool, Error> {
        // Checks external policy repository for new signed manifests
        // Returns true if new policy version detected
        return Ok(false)
    }
    
    fn flush(&self) -> Result<(), Error> {
        self.flush_to_disk()
    }
}

// Default impl for AuditSink used by other modules
impl AuditSink {
    fn default() -> AuditSink {
        // Placeholder key in production; loaded via config
        AuditSink {
            trail: AuditTrail {
                log_path: String::new(),
                signing_key: CryptoKey::default(),
                chain: vec![],
                last_hash: Hash256::ZERO
            }
        }
    }
    
    fn log(&mut self, message: &str) -> Result<(), Error> {
        self.trail.log("AUDIT", message)
    }
    
    fn log_with_data(&mut self, message: &str, data: Map<String, String>) -> Result<(), Error> {
        self.trail.log_with_data("AUDIT", message, Some(data))
    }
    
    fn check_for_policy_updates(&mut self) -> Result<bool, Error> {
        self.trail.check_for_policy_updates()
    }
}
