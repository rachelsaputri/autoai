;
; Kixtart Compliance Auditor
; This script performs a compliance audit on the local Windows system.
; It checks registry keys and system properties against predefined rules.
;

Option "Explicit"
Option "Braces"

;
; Define Compliance Rules
; Structure: Rule Name | Registry Key | Expected Value | Comparison Type
;
Dim $Rules[5][3]
$Rules[0][0] = "RequirePassword" ; Rule Name (Not used in logic, for reference)
$Rules[0][1] = "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System" ; Key
$Rules[0][2] = "1"              ; Expected Value (DWord)
$Rules[0][3] = "Equal"          ; Comparison

$Rules[1][0] = "EnableFirewall"
$Rules[1][1] = "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile"
$Rules[1][2] = "1"
$Rules[1][3] = "Equal"

$Rules[2][0] = "DisableGuestAccount"
$Rules[2][1] = "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon"
$Rules[2][2] = "0"
$Rules[2][3] = "Equal"

$Rules[3][0] = "AuditPolicy_Change"
$Rules[3][1] = "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa"
$Rules[3][2] = "1"
$Rules[3][3] = "Equal"

$Rules[4][0] = "ScreenSaverSecure"
$Rules[4][1] = "HKCU\\Control Panel\\Desktop"
$Rules[4][2] = "1"
$Rules[4][3] = "Equal"

;
; Initialize Variables
;
Dim $i, $key, $expected, $type, $current, $result
Dim $violations = 0
Dim $passed = 0
Dim $totalRules = UBound($Rules, 1)

;
; Start Audit
;
Print "Starting Compliance Audit..."
Print "================================"

For $i = 0 To $totalRules - 1
    $key = $Rules[$i][1]
    $expected = $Rules[$i][2]
    $type = $Rules[$i][3]
    
    ; Read Registry Value
    $current = ReadValue($key, "", 0) ; Reading Default Value (Empty Name)
    If @error <> 0
        $current = -1 ; Indicates Error/Not Found
    EndIf
    
    ; Compare Values
    $result = False
    If $type = "Equal"
        If $current = $expected
            $result = True
        EndIf
    EndIf
    
    ; Check Result
    If $result
        $passed = $passed + 1
        Print "[PASS] Rule " + CStr($i + 1) + ": Configuration matches expected value."
    Else
        $violations = $violations + 1
        Print "[FAIL] Rule " + CStr($i + 1) + ": Compliance violation detected."
    EndIf
Next

;
; Summary
;
Print "================================"
Print "Audit Complete."
Print "Total Rules Checked: " + CStr($totalRules)
Print "Passed: " + CStr($passed)
Print "Violations: " + CStr($violations)

If $violations > 0
    Exit 1
Else
    Exit 0
EndIf
