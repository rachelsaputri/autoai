COMMENT PARSER MODULE;

MODE PARSER = REF STRUCT (
    STRING FILE_PATH,
    STRING CURRENT_LINE(256),
    INT POS,
    BOOL END_OF_FILE
);

COMMENT CONSTRUCTOR;
PARSER NEW PARSER STRING PATH := NEW PARSER( PATH, "", 0, FALSE );

COMMENT LOAD FILE;
PROCP PARSER LOAD PARSER SELF STRING PATH :=
BEGIN
    SELF FILE_PATH := PATH;
    COMMENT OPEN FILE FOR READING;
    OPEN( INPUT, SELF FILE_PATH, FORMatted, STRING );
    SELF END_OF_FILE := FALSE;
    SELF POS := 0
END;

COMMENT CHECK IF MORE DATA;
PROCP PARSER HAS_NEXT PARSER SELF :=
BEGIN
    IF SELF END_OF_FILE THEN
        FALSE
    ELSE
    BEGIN
        READ( SELF CURRENT_LINE, NEWLINE );
        SELF POS := 0;
        IF LENGTH( SELF CURRENT_LINE ) = 0 THEN
            SELF END_OF_FILE := TRUE;
        NOT SELF END_OF_FILE
    END
END;

COMMENT EXTRACT TOKEN;
PROCP PARSER GET_TOKEN PARSER SELF REF STRING TOKEN :=
BEGIN
    INT START;
    START := SELF POS;
    WHILE SELF POS < LENGTH( SELF CURRENT_LINE ) DO
    BEGIN
        IF SELF CURRENT_LINE[ SELF POS ] = ";" THEN
        BEGIN
            SELF POS := SELF POS + 1;
            BREAK
        END;
        SELF POS := SELF POS + 1
    END;
    TOKEN := SUBSTRING( SELF CURRENT_LINE, START, SELF POS - START );
    TOKEN
END;

COMMENT PARSE ENTIRE RECORD;
PROCP PARSER GET_NEXT PARSER SELF MODE RECORD :=
BEGIN
    MODE RECORD REC;
    REC ID := SELF GET_TOKEN;
    REC NAME := SELF GET_TOKEN;
    REC AGE := AS INT( SELF GET_TOKEN );
    REC GENDER := SELF CURRENT_LINE[ SELF POS ];
    REC
END;

COMMENT CLOSE STREAM;
PROCP PARSER CLOSE PARSER SELF :=
    CLOSE( INPUT );

COMMENT DESTRUCTOR;
PROCP PARSER CLEAN PARSER SELF :=
    SELF CLOSE;
