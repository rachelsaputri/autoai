COMMENT MAIN ALGOL 60 DRIVER MODULE;

COMMENT INCLUDE DEPENDENCIES;
INCLUDE "parser.a60";
INCLUDE "validator.a60";
INCLUDE "reporter.a60";

COMMENT DECLARE GLOBAL TYPES AND STATE;
MODE RECORD = STRUCT( STRING ID(20), STRING NAME(50), INT AGE, CHAR GENDER(1) );
MODE PROC RESULT = PROC VOID( RECORD REC, REF BOOL VALID );

COMMENT DECLARE MAIN ENTRY POINT;
MAIN:
BEGIN
    COMMENT INITIALIZATION;
    BOOL STATUS;
    INT RECORD_COUNT;
    RECORD CURRENT_REC;
    RESULT VALIDATOR;
    RESULT PARSER;
    RESULT REPORTER;

    COMMENT PARSE INPUT;
    PARSER := NEW PARSER;
    PARSER LOAD "data.txt";

    COMMENT PROCESS EACH RECORD;
    RECORD_COUNT := 0;
    VALIDATOR := NEW VALIDATOR;
    REPORTER := NEW REPORTER;

    WHILE PARSER HAS_NEXT DO
    BEGIN
        CURRENT_REC := PARSER GET_NEXT;
        RECORD_COUNT := RECORD_COUNT + 1;
        VALIDATOR CHECK CURRENT_REC, STATUS;
        REPORTER ADD_CURRENT CURRENT_REC, STATUS
    END;

    COMMENT FINALIZE;
    REPORTER WRITE "output.txt";
    FORMAT "Processing Complete. Records: %d\n" RECORD_COUNT
END;
