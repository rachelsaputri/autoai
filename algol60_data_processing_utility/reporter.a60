COMMENT REPORTER MODULE;

MODE REPORTER = REF STRUCT (
    STRING OUTPUT_PATH,
    INT RECORDS_PROCESSED,
    INT VALID_RECORDS,
    INT INVALID_RECORDS
);

COMMENT CONSTRUCTOR;
REPORTER NEW REPORTER := NEW REPORTER( "report.txt", 0, 0, 0 );

COMMENT ADD RESULT;
PROCP REPORTER ADD_CURRENT REPORTER SELF MODE RECORD REC REF BOOL STATUS :=
BEGIN
    SELF RECORDS_PROCESSED := SELF RECORDS_PROCESSED + 1;
    IF STATUS THEN
        SELF VALID_RECORDS := SELF VALID_RECORDS + 1
    ELSE
        SELF INVALID_RECORDS := SELF INVALID_RECORDS + 1
END;

COMMENT WRITE REPORT;
PROCP REPORTER WRITE REPORTER SELF STRING PATH :=
BEGIN
    SELF OUTPUT_PATH := PATH;
    COMMENT OPEN OUTPUT FILE;
    OPEN( OUTPUT, SELF OUTPUT_PATH, FORMatted, STRING );
    FORMAT "DATA PROCESSING REPORT\n";
    FORMAT "=====================\n";
    FORMAT "TOTAL RECORDS: %d\n", SELF RECORDS_PROCESSED;
    FORMAT "VALID: %d\n", SELF VALID_RECORDS;
    FORMAT "INVALID: %d\n", SELF INVALID_RECORDS;
    CLOSE( OUTPUT )
END;
