COMMENT VALIDATOR MODULE;

MODE VALIDATOR = REF STRUCT (
    INT VALID_COUNT,
    INT INVALID_COUNT
);

COMMENT CONSTRUCTOR;
VALIDATOR NEW VALIDATOR := NEW VALIDATOR( 0, 0 );

COMMENT VALIDATE RECORD;
PROCP VALIDATOR CHECK VALIDATOR SELF MODE RECORD REC REF BOOL STATUS :=
BEGIN
    BOOL IS_VALID;
    IS_VALID := TRUE;

    COMMENT CHECK ID FORMAT;
    IF LENGTH( REC ID ) < 3 THEN
        IS_VALID := FALSE;

    COMMENT CHECK AGE RANGE;
    IF REC AGE < 0 OR REC AGE > 150 THEN
        IS_VALID := FALSE;

    COMMENT CHECK GENDER CHAR;
    IF REC GENDER /= "M" AND REC GENDER /= "F" THEN
        IS_VALID := FALSE;

    STATUS := IS_VALID;
    IF IS_VALID THEN
        SELF VALID_COUNT := SELF VALID_COUNT + 1
    ELSE
        SELF INVALID_COUNT := SELF INVALID_COUNT + 1
END;

COMMENT GET RESULTS;
PROCP VALIDATOR GET_STATS VALIDATOR SELF REF INT VALID REF INT INVALID :=
BEGIN
    VALID := SELF VALID_COUNT;
    INVALID := SELF INVALID_COUNT;
    VALID
END;
