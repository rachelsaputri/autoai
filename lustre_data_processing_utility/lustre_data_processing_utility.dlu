/**
 * Lustre Data Processing Utility
 * 
 * A formally verified, synchronous data-flow pipeline for processing
 * integer data streams. Includes ingestion, transformation, validation,
 * and reporting modules.
 * 
 * Language: Lustre v3
 */

(* ============================================
   MODULE: Data Types & Interfaces
   ============================================ *)

(* Basic integer type alias for clarity *)
type int = int;

(* Node Signature: Data Ingestion *)
(* Simulates receiving a stream of integer data points *)
let node ingestion_node(raw_signal: int) returns (is_valid: bool; data_value: int);
   let data_value = raw_signal -> 0; (* Preceding value init to 0 *)
   let is_valid = true; (* Always valid at ingestion level, business logic downstream *)
   true; (* Initial condition: valid and value is raw_signal *)
end;

(* ============================================
   MODULE: Data Transformation
   ============================================ *)

(* Node Signature: Linear Transformation *)
(* Transforms data using: y = (x * scale) + offset *)
let node transform_node(data_value: int; scale: int; offset: int) returns (transformed_value: int);
   let transformed_value = (data_value * scale) + offset;
   true;
end;

(* Node Signature: Rate Limiter / Sampler *)
(* Processes data only when trigger is true *)
let node sampler_node(trigger: bool; data: int) returns (sampled_data: int);
   let sampled_data = if trigger then data -> 0 else sampled_data -> 0 endif;
   true;
end;

(* ============================================
   MODULE: Data Validation
   ============================================ *)

(* Node Signature: Threshold Validator *)
(* Checks if data is within [min_limit, max_limit] *)
let node validator_node(data_value: int; min_limit: int; max_limit: int) returns (is_within_bounds: bool); 
   let is_within_bounds = (data_value >= min_limit) and (data_value <= max_limit);
   true;
end;

(* Node Signature: Anomaly Detector *)
(* Detects rapid changes in data stream (derivative check) *)
let node anomaly_detector(data_value: int; sensitivity: int) returns (is_anomaly: bool);
   let previous_value = data_value -> 0;
   let diff = abs(data_value - previous_value);
   let is_anomaly = diff > sensitivity;
   true;
end;

(* ============================================
   MODULE: Reporting & Aggregation
   ============================================ *)

(* Node Signature: Count Accumulator *)
(* Counts the number of valid events *)
let node counter_node(valid_event: bool) returns (count: int);
   let count = fby(0, if valid_event then count -> 0 + 1 else count -> 0 endif);
   true;
end;

(* Node Signature: Rolling Average *)
(* Computes simple moving average over window_size items *)
let node rolling_average_node(data_value: int; window_size: int) returns (avg: int);
   var window_sum: int;
   var count: int;
   var idx: int;
   
   clock = fby(true, clock and (idx < window_size -> 0));
   
   if idx >= window_size then 
       window_sum := 0;
       idx := 0;
       count := window_size;
   else
       window_sum := window_sum + data_value;
       idx := idx + 1;
       count := idx;
   endif;
   
   avg = window_sum / (count -> 1); (* Avoid div by zero *)
   
   true;
end;

(* ============================================
   MAIN PIPELINE ORCHESTRATOR
   ============================================ *)

(* Configuration Constants *)
let config_scale = 2;
let config_offset = 10;
let config_min = -100;
let config_max = 500;
let config_sensitivity = 50;

(* Main Node: Orchestrates the entire pipeline *)
let node lustre_data_processing_utility(raw_input: int) returns 
    (final_output: int; 
     is_valid: bool; 
     is_anomaly: bool; 
     anomaly_count: int; 
     current_avg: int);

   (* Stage 1: Ingestion *)
   let ingested = ingestion_node(raw_input);
   
   (* Stage 2: Transformation *)
   let transformed = transform_node(ingested.data_value, config_scale, config_offset);
   
   (* Stage 3: Validation (Bounds Check) *)
   let bounds_check = validator_node(transformed, config_min, config_max);
   
   (* Stage 4: Anomaly Detection *)
   let anomaly_flag = anomaly_detector(transformed, config_sensitivity);
   
   (* Stage 5: Reporting *)
   let count_acc = counter_node(bounds_check and not anomaly_flag);
   let avg_calc = rolling_average_node(transformed, 10); (* Window of 10 *)
   
   (* Final Output Mapping *)
   final_output = if bounds_check then transformed else -1 endif; (* -1 indicates error *)
   is_valid = bounds_check;
   is_anomaly = anomaly_flag;
   anomaly_count = count_acc;
   current_avg = avg_calc;
   
   true;
end;

(* Export the main node for code generation *)
export let lustre_data_processing_utility(raw_input); 
