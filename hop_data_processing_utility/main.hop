; main.hop - Main entry point for Hop Data Processing Utility

(import (hop-io) (hop-core))

;; Configuration
(define data-dir "data")
(define log-file "process.log")

;; Initialize the logging system
(init-log log-file)

;; Main processing function
(define (process-data)
  (log-info "Starting data processing...")
  (let ((data (load-data)))
    (if (empty? data)
        (log-warn "No data found to process.")
        (let ((transformed (transform data))
              (validated (validate transformed)))
          (save-results validated)
          (log-info "Data processing completed successfully."))))
  (log-shutdown))

;; Run the main processing function
(process-data)
