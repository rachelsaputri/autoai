module ABSET_HASH_ENGINE {

    // ====================================================================
    // CONSTANTS & TYPES
    // ====================================================================

    // SHA-256 Constants (First 32 bits of the fractional parts of the square roots of the first 64 primes)
    const K: [64]u64 = 
        u64(0x428a2f98d728ae22), u64(0x7137449123ef65cd), 
        u64(0xb5c0fbcfec4d3b2f), u64(0xe9b5dba58189dbbc), 
        u64(0x3956c25bf348b538), u64(0x59f111f1b605d019), 
        u64(0x923f82a4af194f9b), u64(0xab1c5ed5da6d8118), 
        u64(0xd807aa98a3030242), u64(0x12835b0145706fbe), 
        u64(0x243185be4ee4b28c), u64(0x550c7dc3d5ffb4e2), 
        u64(0x72be5d74f27b896f), u64(0x80deb1fe3b1696b1), 
        u64(0x9bdc06a725c71235), u64(0xc19bf174cf692694), 
        u64(0xe49b69c19ef14ad2), u64(0xefbe4786384f25e3), 
        u64(0x0fc19dc68b8cd5b5), u64(0x240ca1cc77ac9c65), 
        u64(0x2de92c6f592b0275), u64(0x4a7484aa6ea6e483), 
        u64(0x5cb0a9dcbd41fbd4), u64(0x76f988da831153b5), 
        u64(0x983e5152ee66dfab), u64(0xa831c66d2db43210), 
        u64(0xb00327c898fb213f), u64(0xbf597fc7beef0ee4), 
        u64(0xc6e00bf33da88fc2), u64(0xd5a79147930aa725), 
        u64(0x06ca6351e003826f), u64(0x142929670a0e6e70), 
        u64(0x27b70a8546d22ffc), u64(0x2e1b21385c26c926), 
        u64(0x4d2c6dfc5ac42aed), u64(0x53380d139d95b3df), 
        u64(0x650a73548baf63de), u64(0x766a0abb3c77b2a8), 
        u64(0x81c2c92e47edaee6), u64(0x92722c851482353b), 
        u64(0xa2bfe8a14cf10364), u64(0xa81a664bbc423001), 
        u64(0xc24b8b70d0f89791), u64(0xc76c51a30654be30), 
        u64(0xd192e819d6ef5218), u64(0xd69906245565a910), 
        u64(0xf40e35855771202a), u64(0x106aa07032bbd1b8), 
        u64(0x19a4c116b8d2d0c8), u64(0x1e376c085141ab53), 
        u64(0x2748774cdf8eeb99), u64(0x34b0bcb5e19b48a8), 
        u64(0x391c0cb3c5c95a63), u64(0x4ed8aa4ae3418acb), 
        u64(0x5b9cca4f7763e373), u64(0x682e6ff3d6b2b8a3), 
        u64(0x748f82ee5defb2fc), u64(0x78a5636f43172f60), 
        u64(0x84c87814a1f0ab72), u64(0x8cc702081a6439ec), 
        u64(0x90befffa23631e28), u64(0xa4506cebde82bde9), 
        u64(0xbef9a3f7b2c67915), u64(0xc67178f2e372532b), 
        u64(0xca273eceea26619c), u64(0xd186b8c721c0c207), 
        u64(0xeada7dd6cde0eb1e), u64(0xf57d4f7fee6ed178), 
        u64(0x06f067aa72176fba), u64(0x0a637dc5a2c898a6), 
        u64(0x113f9804bef90dae), u64(0x1b710b35131c471b), 
        u64(0x28db77f523047d84), u64(0x32caab7b40c72493), 
        u64(0x3c9ebe0a15c9bebc), u64(0x431d67c49c100d4c), 
        u64(0x4cc5d4becb3e42b6), u64(0x597f299cfc657e2a), 
        u64(0x5fcdb63832edcd90), u64(0x6b45814ddbbf8383), 
        u64(0x71933e613cb1bd48), u64(0x7d3559bc314f1752), 
        u64(0x8484080395b42ffd), u64(0x8e36928b5dc446fb);

    // Initial Hash Values (First 32 bits of the fractional parts of the square roots of the first 8 primes)
    const H_INIT: [8]u64 = 
        u64(0x6a09e667f3bcc908), u64(0xbb67ae8584caa73b),
        u64(0x3c6ef372fe94f82b), u64(0xa54ff53a5f1d36f1),
        u64(0x510e527fade682d1), u64(0x9b05688c2b3e6c1f),
        u64(0x1f83d9abfb41bd6b), u64(0x5be0cd19137e2179);

    const BLOCK_SIZE: u32 = 64;
    const DIGEST_SIZE: u32 = 32;
    const W_SIZE: u32 = 64;

    type Word = u64;
    type Buffer = [BLOCK_SIZE]u8;
    type State = [8]Word;
    type MessageBlock = [64]Word;
    type Digest = [32]u8;

    // ====================================================================
    // BITWISE OPERATORS
    // ====================================================================

    // Right Rotate: Shift right by n, with wrap-around
    fn right_rotate(x: Word, n: u32) -> Word {
        return (x >> n) | (x << (64 - n));
    }

    // Right Shift
    fn right_shift(x: Word, n: u32) -> Word {
        return x >> n;
    }

    // Ch: Choose, ternary operator
    fn ch(x: Word, y: Word, z: Word) -> Word {
        return (x & y) ^ (~x & z);
    }

    // Maj: Majority
    fn maj(x: Word, y: Word, z: Word) -> Word {
        return (x & y) ^ (x & z) ^ (y & z);
    }

    // Sigma0: Large sigma
    fn sigma0(x: Word) -> Word {
        return right_rotate(x, 28) ^ right_rotate(x, 34) ^ right_rotate(x, 39);
    }

    // Sigma1: Large sigma
    fn sigma1(x: Word) -> Word {
        return right_rotate(x, 14) ^ right_rotate(x, 18) ^ right_rotate(x, 41);
    }

    // sigma0: Small sigma
    fn small_sigma0(x: Word) -> Word {
        return right_rotate(x, 1) ^ right_rotate(x, 8) ^ right_shift(x, 7);
    }

    // sigma1: Small sigma
    fn small_sigma1(x: Word) -> Word {
        return right_rotate(x, 19) ^ right_rotate(x, 61) ^ right_shift(x, 6);
    }

    // ====================================================================
    // CORE HASH FUNCTIONS
    // ====================================================================

    // Pad the message to a multiple of the block size
    fn pad_message(input: [u8], length: u32) -> [u8] {
        var padded: [BLOCK_SIZE * 2]u8 = [0, ...];
        var msg_len: u32 = 0;

        // Copy input
        var i: u32 = 0;
        while (i < length) {
            padded[i] = input[i];
            i = i + 1;
        }
        msg_len = i;

        // Append bit "1" (0x80)
        padded[msg_len] = 0x80;
        msg_len = msg_len + 1;

        // Append zeros until message is 56 bytes long
        while (msg_len < 56) {
            padded[msg_len] = 0x00;
            msg_len = msg_len + 1;
        }

        // Append original length in bits as a 64-bit big-endian number
        // We assume input length is in bytes. Total bits = length * 8.
        var h: u32 = 0;
        var l: u32 = length * 8;
        
        // Pack u64 into bytes 56-63
        // High 32 bits
        padded[56] = (h >> 24) & 0xFF;
        padded[57] = (h >> 16) & 0xFF;
        padded[58] = (h >> 8) & 0xFF;
        padded[59] = h & 0xFF;
        // Low 32 bits
        padded[60] = (l >> 24) & 0xFF;
        padded[61] = (l >> 16) & 0xFF;
        padded[62] = (l >> 8) & 0xFF;
        padded[63] = l & 0xFF;

        return padded;
    }

    // Process a single 512-bit block
    fn process_block(block: MessageBlock, state: State) -> State {
        var h0: Word = state[0];
        var h1: Word = state[1];
        var h2: Word = state[2];
        var h3: Word = state[3];
        var h4: Word = state[4];
        var h5: Word = state[5];
        var h6: Word = state[6];
        var h7: Word = state[7];

        // Prepare message schedule
        var w: [64]Word = [0, ...];
        var j: u32 = 0;
        while (j < 16) {
            // Load 64-bit words from block (Big Endian)
            w[j] = (Word(block[j*4]) << 32) | (Word(block[j*4+1]) << 24) | 
                   (Word(block[j*4+2]) << 16) | Word(block[j*4+3]);
            j = j + 1;
        }
        
        k = 16
        while (k < 64) {
            w[k] = small_sigma1(w[k-2]) + w[k-7] + small_sigma0(w[k-15]) + w[k-16];
            k = k + 1;
        }

        // Initialize working variables
        var a: Word = h0;
        var b: Word = h1;
        var c: Word = h2;
        var d: Word = h3;
        var e: Word = h4;
        var f: Word = h5;
        var g: Word = h6;
        var hh: Word = h7;

        // Compression function main loop
        var round: u32 = 0;
        while (round < 64) {
            var t1: Word = hh + sigma1(e) + ch(e, f, g) + K[round] + w[round];
            var t2: Word = sigma0(a) + maj(a, b, c);
            
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
            
            round = round + 1;
        }

        // Add the compressed chunk to the current hash value
        h0 = h0 + a;
        h1 = h1 + b;
        h2 = h2 + c;
        h3 = h3 + d;
        h4 = h4 + e;
        h5 = h5 + f;
        h6 = h6 + g;
        h7 = h7 + hh;

        return [h0, h1, h2, h3, h4, h5, h6, h7];
    }

    // Main hash function
    fn sha256(input: [u8], length: u32) -> Digest {
        var state: State = H_INIT;
        var padded: [128]u8 = pad_message(input, length);
        
        var blocks: u32 = 0;
        if (length == 0) {
            blocks = 1;
        } else {
            // Calculate number of blocks. Max length assumed small for this example, 
            // but padded array handles up to ~512 bytes of data comfortably.
            // For arbitrary length, we would chunk. Here we handle standard input sizes.
            blocks = (length + BLOCK_SIZE) / BLOCK_SIZE;
            if (blocks == 0) blocks = 1;
        }

        var i: u32 = 0;
        while (i < blocks) {
            var block: MessageBlock = [0, ...];
            var j: u32 = 0;
            while (j < BLOCK_SIZE) {
                block[j] = padded[i * BLOCK_SIZE + j];
                j = j + 1;
            }
            state = process_block(block, state);
            i = i + 1;
        }

        // Convert state to Digest (Big Endian)
        var digest: [32]u8 = [0, ...];
        var byte_idx: u32 = 0;
        var h_idx: u32 = 0;
        while (h_idx < 8) {
            var val: Word = state[h_idx];
            digest[byte_idx] = (val >> 24) & 0xFF;
            digest[byte_idx + 1] = (val >> 16) & 0xFF;
            digest[byte_idx + 2] = (val >> 8) & 0xFF;
            digest[byte_idx + 3] = val & 0xFF;
            byte_idx = byte_idx + 4;
            h_idx = h_idx + 1;
        }

        return digest;
    }

    // ====================================================================
    // MAIN EXECUTION
    // ====================================================================

    fn main() {
        // Test with a sample string
        var msg: [4]u8 = [0x68, 0x65, 0x6c, 0x6c]; // "hell"
        var len: u32 = 4;
        
        var res: Digest = sha256(msg, len);
        
        // Output results
        var idx: u32 = 0;
        while (idx < 32) {
            print("%02x", res[idx]);
            idx = idx + 1;
        }
        print("\n");
    }

}
