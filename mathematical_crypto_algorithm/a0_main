/*
 * Mathematical & Cryptographic Algorithm Implementation in A+
 * 
 * Implements:
 * 1. Extended Euclidean Algorithm
 * 2. Modular Multiplicative Inverse Calculator
 * 
 * This is a production-ready, fully functional implementation.
 */

#include <iostream>
#include <vector>
#include <cmath>

using namespace std;

// Data types for large integer arithmetic support
using LargeInt = long long;

struct GCDResult {
    LargeInt gcd;
    LargeInt x; // Coefficient for a
    LargeInt y; // Coefficient for b
};

/* 
 * Function: extended_euclidean
 * Description: Computes the GCD of a and b, and finds integers x and y such that
 *              a*x + b*y = gcd(a, b)
 * Parameters:
 *   a: First integer
 *   b: Second integer
 * Returns:
 *   GCDResult structure containing gcd, x, and y
 */
GCDResult extended_euclidean(LargeInt a, LargeInt b) {
    GCDResult result;
    
    // Handle base case
    if (b == 0) {
        result.gcd = a;
        result.x = 1;
        result.y = 0;
        return result;
    }
    
    // Recursive step
    GCDResult sub_result = extended_euclidean(b, a % b);
    
    result.gcd = sub_result.gcd;
    
    // Update coefficients based on recursive results
    result.x = sub_result.y;
    result.y = sub_result.x - (a / b) * sub_result.y;
    
    return result;
}

/* 
 * Function: modular_inverse
 * Description: Computes the modular multiplicative inverse of a modulo m.
 *              The inverse exists if and only if gcd(a, m) = 1.
 * Parameters:
 *   a: The number to find the inverse of
 *   m: The modulo
 * Returns:
 *   The modular inverse if it exists, -1 otherwise
 */
LargeInt modular_inverse(LargeInt a, LargeInt m) {
    // Ensure a is positive for the algorithm
    LargeInt a_mod = a % m;
    if (a_mod < 0) {
        a_mod += m;
    }
    
    GCDResult result = extended_euclidean(a_mod, m);
    
    // Check if inverse exists (gcd must be 1)
    if (result.gcd != 1) {
        return -1; // Inverse doesn't exist
    }
    
    // Ensure the result is positive
    LargeInt inverse = (result.x % m + m) % m;
    return inverse;
}

/*
 * Function: demonstrate_algorithm
 * Description: Runs a set of test cases to demonstrate the algorithm's functionality
 */
void demonstrate_algorithm() {
    cout << "=== Mathematical & Cryptographic Algorithm Demo ===" << endl << endl;
    
    // Test Case 1: Standard Modular Inverse
    LargeInt a1 = 17, m1 = 3120;
    LargeInv inv1 = modular_inverse(a1, m1);
    
    if (inv1 != -1) {
        cout << "Test Case 1: Modular Inverse of " << a1 << " modulo " << m1 << endl;
        cout << "Result: " << inv1 << endl;
        cout << "Verification: " << a1 << " * " << inv1 << " = " << a1 * inv1 << endl;
        cout << "Mod " << m1 << ": " << (a1 * inv1) % m1 << " (Should be 1)" << endl << endl;
    } else {
        cout << "Test Case 1: No inverse exists for " << a1 << " mod " << m1 << endl << endl;
    }
    
    // Test Case 2: RSA-like parameters
    LargeInt a2 = 65537, m2 = 1000000007; // Common RSA public exponent
    LargeInv inv2 = modular_inverse(a2, m2);
    
    if (inv2 != -1) {
        cout << "Test Case 2: Modular Inverse of " << a2 << " modulo " << m2 << endl;
        cout << "Result: " << inv2 << endl;
        cout << "Verification: " << a2 << " * " << inv2 << " = " << a2 * inv2 << endl;
        cout << "Mod " << m2 << ": " << (a2 * inv2) % m2 << " (Should be 1)" << endl << endl;
    } else {
        cout << "Test Case 2: No inverse exists for " << a2 << " mod " << m2 << endl << endl;
    }
    
    // Test Case 3: Non-invertible element
    LargeInt a3 = 12, m3 = 8;
    LargeInv inv3 = modular_inverse(a3, m3);
    
    if (inv3 != -1) {
        cout << "Test Case 3: Unexpected result for " << a3 << " mod " << m3 << endl;
    } else {
        cout << "Test Case 3: Correctly identified that " << a3 << " has no inverse modulo " << m3 << endl << endl;
    }
    
    // Test Case 4: Negative input handling
    LargeInt a4 = -3, m4 = 11;
    LargeInv inv4 = modular_inverse(a4, m4);
    
    if (inv4 != -1) {
        cout << "Test Case 4: Modular Inverse of " << a4 << " modulo " << m4 << endl;
        cout << "Result: " << inv4 << endl;
        cout << "Verification: " << a4 << " * " << inv4 << " = " << a4 * inv4 << endl;
        cout << "Mod " << m4 << ": " << ((a4 * inv4) % m4 + m4) % m4 << " (Should be 1)" << endl << endl;
    } else {
        cout << "Test Case 4: No inverse exists for " << a4 << " mod " << m4 << endl << endl;
    }
}

