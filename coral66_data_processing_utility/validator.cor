! VALIDATOR Module
MODULE validator;
  IMPORT types;

  FUNCTION validateRecord(record types.RecordType) RETURN BOOLEAN
    BEGIN
      IF record.id > 0 AND record.id < 1000000 THEN
        RETURN TRUE;
      ELSE
        RETURN FALSE;
      ENDIF;
    END;

  FUNCTION validateAllRecords(records ARRAY OF types.RecordType) RETURN ARRAY OF types.RecordType
    VAR validRecords IS ARRAY OF types.RecordType;
    VAR i IS INTEGER;
    BEGIN
      INITIALIZE validRecords TO EMPTY;
      FOR i := 0 TO LENGTH(records) - 1 DO
        IF validateRecord(records[i]) THEN
          ADD TO validRecords records[i];
        ENDIF;
      ENDFOR;
      RETURN validRecords;
    END;
ENDMODULE;
